// Farm-to-Table Platform – Prisma schema
// Updated from docs/updateschema.text

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  customer
  farmer
}

enum UserStatus {
  active
  suspended
}

enum HarvestStatus {
  pending
  approved
  rejected
}

enum DeliveryFrequency {
  weekly
  monthly
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum OrderStatus {
  pending
  packed
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum DeliveryStatus {
  scheduled
  out_for_delivery
  delivered
  failed
}

enum CapacityStatus {
  open
  locked
  closed
}

enum ReservationStatus {
  reserved
  consumed
  released
  expired
}

enum SubscriptionOrderCycleOutcome {
  created
  skipped
  failed
}

// ---------------------------------------------------------------------------
// 1. Core System Entities
// ---------------------------------------------------------------------------

model User {
  id        String     @id @default(cuid())
  name      String
  email     String?    @unique
  phone     String     @unique
  imageUrl  String?    @map("image_url")
  password  String
  role      UserRole
  status    UserStatus @default(active)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  customer  Customer?
  farmer    Farmer?

  addresses Address[]

  referralsGiven    Referral[]  @relation("Referrer")
  referralsReceived Referral[]  @relation("Referred")

  approvedHarvests Harvest[] @relation("HarvestApprover")

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]
  orders        Order[]

  @@map("customers")
}

model Farmer {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  farmName        String   @map("farm_name")
  farmLocation    String   @map("farm_location")
  farmDescription String?  @map("farm_description")
  farmImage       String?  @map("farm_image")
  approved        Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  products Product[]
  harvests Harvest[]
  boxItems BoxItem[]
  orderItems OrderItem[]

  @@map("farmers")
}

model Address {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  addressLine String  @map("address_line")
  city        String
  state       String
  postalCode  String  @map("postal_code")
  country     String
  isDefault   Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ---------------------------------------------------------------------------
// 2. Product Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  farmerId    String
  categoryId  String
  name        String
  description String?
  unit        String
  basePrice   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())

  farmer   Farmer   @relation(fields: [farmerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  images   ProductImage[]
  harvests Harvest[]
  boxItems BoxItem[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  imageUrl  String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ---------------------------------------------------------------------------
// 3. Farmer Inventory (Harvest)
// ---------------------------------------------------------------------------

model Harvest {
  id        String        @id @default(cuid())
  farmerId  String
  productId String

  quantityAvailable Int
  unitPrice         Decimal @db.Decimal(10, 2)

  harvestDate    DateTime
  availableUntil DateTime

  status HarvestStatus @default(pending)

  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())

  farmer   Farmer  @relation(fields: [farmerId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  approver User?   @relation("HarvestApprover", fields: [approvedBy], references: [id])

  @@map("harvests")
}

// ---------------------------------------------------------------------------
// 4. Box System
// ---------------------------------------------------------------------------

model Box {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  versions BoxVersion[]
  plans    SubscriptionPlan[]
  subscriptions Subscription[]

  @@map("boxes")
}

model BoxVersion {
  id          String   @id @default(cuid())
  boxId       String
  versionName String

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())

  box Box @relation(fields: [boxId], references: [id])

  items      BoxItem[]
  orders     Order[]
  capacities CapacitySnapshot[]
  reservations InventoryReservation[]

  @@map("box_versions")
}

model BoxItem {
  id           String @id @default(cuid())
  boxVersionId String
  productId    String
  farmerId     String

  quantity Int
  optional Boolean @default(false)

  boxVersion BoxVersion @relation(fields: [boxVersionId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  farmer     Farmer     @relation(fields: [farmerId], references: [id])

  @@map("box_items")
}

// ---------------------------------------------------------------------------
// 5. Subscriptions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id                String   @id @default(cuid())
  boxId             String
  name              String
  price             Decimal  @db.Decimal(10, 2)

  deliveryFrequency DeliveryFrequency
  deliveriesPerCycle Int

  active Boolean @default(true)

  createdAt DateTime @default(now())

  box Box @relation(fields: [boxId], references: [id])

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id         String   @id @default(cuid())
  customerId String
  planId     String
  boxId      String?

  status SubscriptionStatus @default(active)

  startDate        DateTime
  nextDeliveryDate DateTime
  nextOrderDate    DateTime?
  lastOrderDate    DateTime?
  pauseReason      String?
  pauseUntil       DateTime?

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  box      Box? @relation(fields: [boxId], references: [id])

  orders       Order[]
  reservations InventoryReservation[]
  cycleEvents  SubscriptionOrderCycleEvent[]

  @@index([status, nextOrderDate], map: "subscriptions_status_next_order_idx")
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// 6. Orders
// ---------------------------------------------------------------------------

model Order {
  id             String   @id @default(cuid())
  customerId     String
  subscriptionId String?
  boxVersionId   String
  cycleDate      DateTime?

  status OrderStatus @default(pending)

  totalPrice Decimal @db.Decimal(10, 2)

  deliveryDate DateTime?

  createdAt DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  boxVersion BoxVersion @relation(fields: [boxVersionId], references: [id])

  items     OrderItem[]
  payments  Payment[]
  delivery  Delivery?

  @@index([cycleDate], map: "orders_cycle_date_idx")
  @@unique([subscriptionId, cycleDate], map: "orders_subscription_cycle_key")
  @@map("orders")
}

model SubscriptionOrderCycleEvent {
  id             String                        @id @default(cuid())
  subscriptionId String?                       @map("subscription_id")
  cycleDate      DateTime?                     @map("cycle_date")
  referenceDate  DateTime                      @map("reference_date")
  outcome        SubscriptionOrderCycleOutcome
  reason         String?
  attempt        Int                           @default(1)
  createdAt      DateTime                      @default(now()) @map("created_at")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "subscription_cycle_events_created_idx")
  @@index([subscriptionId, cycleDate], map: "subscription_cycle_events_subscription_cycle_idx")
  @@index([outcome, createdAt], map: "subscription_cycle_events_outcome_created_idx")
  @@map("subscription_order_cycle_events")
}

model CapacitySnapshot {
  id            String         @id @default(cuid())
  boxVersionId  String         @map("box_version_id")
  cycleDate     DateTime       @map("cycle_date")
  maxBoxes      Int            @map("max_boxes")
  reservedBoxes Int            @default(0) @map("reserved_boxes")
  consumedBoxes Int            @default(0) @map("consumed_boxes")
  status        CapacityStatus @default(open)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boxVersion   BoxVersion             @relation(fields: [boxVersionId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@unique([boxVersionId, cycleDate], map: "capacity_snapshot_version_cycle_key")
  @@index([cycleDate], map: "capacity_snapshot_cycle_idx")
  @@map("capacity_snapshots")
}

model InventoryReservation {
  id               String            @id @default(cuid())
  subscriptionId   String            @map("subscription_id")
  boxVersionId     String            @map("box_version_id")
  capacitySnapshotId String          @map("capacity_snapshot_id")
  cycleDate        DateTime          @map("cycle_date")
  quantity         Int               @default(1)
  status           ReservationStatus @default(reserved)
  reason           String?
  idempotencyKey   String            @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  boxVersion     BoxVersion     @relation(fields: [boxVersionId], references: [id], onDelete: Cascade)
  capacitySnapshot CapacitySnapshot @relation(fields: [capacitySnapshotId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, cycleDate], map: "reservation_subscription_cycle_key")
  @@index([status, cycleDate], map: "reservation_status_cycle_idx")
  @@map("inventory_reservations")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  farmerId  String

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  farmer  Farmer  @relation(fields: [farmerId], references: [id])

  @@map("order_items")
}

// ---------------------------------------------------------------------------
// 7. Payment
// ---------------------------------------------------------------------------

model Payment {
  id      String @id @default(cuid())
  orderId String

  amount Decimal @db.Decimal(10, 2)

  paymentMethod String
  paymentStatus PaymentStatus

  transactionReference String?

  paidAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ---------------------------------------------------------------------------
// 8. Delivery
// ---------------------------------------------------------------------------

model Delivery {
  id      String @id @default(cuid())
  orderId String @unique

  deliveryDriver String?

  deliveryStatus DeliveryStatus

  trackingCode String?

  deliveredAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("deliveries")
}

// ---------------------------------------------------------------------------
// 9. Referral
// ---------------------------------------------------------------------------

model Referral {
  id String @id @default(cuid())

  referrerId     String
  referredUserId String

  rewardGiven Boolean @default(false)

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referred User @relation("Referred", fields: [referredUserId], references: [id])

  @@map("referrals")
}

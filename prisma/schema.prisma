// Farm-to-Table Platform – Prisma schema
// Based on docs/farm_to_table_system_entities.txt

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  customer
  farmer
}

enum UserStatus {
  active
  suspended
}

enum DeliveryFrequency {
  weekly
  monthly
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum OrderStatus {
  pending
  packed
  out_for_delivery
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum DeliveryStatus {
  scheduled
  out_for_delivery
  delivered
  failed
}

// ---------------------------------------------------------------------------
// 1. Core System Entities
// ---------------------------------------------------------------------------

model User {
  id           String      @id @default(cuid())
  name         String
  email        String?     @unique
  phone        String      @unique
  password     String
  role         UserRole
  status       UserStatus  @default(active)
  createdAt    DateTime    @default(now()) @map("created_at")

  customer         Customer?
  farmer           Farmer?
  addresses        Address[]
  referralsGiven   Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")

  @@map("users")
}

model Customer {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  defaultAddressId   String?   @map("default_address_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  orders        Order[]

  @@map("customers")
}

model Farmer {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  farmName         String    @map("farm_name")
  farmLocation     String    @map("farm_location")
  farmDescription  String?   @map("farm_description")
  approved         Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  harvests  Harvest[]

  @@map("farmers")
}

model Address {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  addressLine String   @map("address_line")
  city        String
  state       String
  postalCode  String   @map("postal_code")
  isDefault   Boolean  @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ---------------------------------------------------------------------------
// 2. Product & Farm Entities
// ---------------------------------------------------------------------------

model Category {
  id   String @id @default(cuid())
  name String

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  categoryId  String   @map("category_id")
  farmerId    String   @map("farmer_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  farmer         Farmer           @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  harvests       Harvest[]
  planItems      SubscriptionPlanItem[]
  orderItems     OrderItem[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Harvest {
  id             String   @id @default(cuid())
  farmerId       String   @map("farmer_id")
  productId      String   @map("product_id")
  quantity       Int
  harvestDate    DateTime @map("harvest_date")
  availableUntil DateTime @map("available_until")

  farmer  Farmer  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("harvests")
}

// ---------------------------------------------------------------------------
// 3. Subscription System
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id                 String            @id @default(cuid())
  name               String
  description        String?
  price              Decimal           @db.Decimal(10, 2)
  deliveryFrequency  DeliveryFrequency @map("delivery_frequency")
  active             Boolean           @default(true)

  planItems    SubscriptionPlanItem[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model SubscriptionPlanItem {
  id        String @id @default(cuid())
  planId    String @map("plan_id")
  productId String @map("product_id")
  quantity  Int

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("subscription_plan_items")
}

model Subscription {
  id                String             @id @default(cuid())
  customerId        String             @map("customer_id")
  planId            String             @map("plan_id")
  status            SubscriptionStatus @default(active)
  startDate         DateTime          @map("start_date")
  nextDeliveryDate  DateTime          @map("next_delivery_date")
  pauseUntil        DateTime?         @map("pause_until")
  createdAt         DateTime          @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  orders   Order[]

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// 4. Order System
// ---------------------------------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  customerId     String      @map("customer_id")
  subscriptionId String?     @map("subscription_id")
  status         OrderStatus @default(pending)
  totalPrice     Decimal     @map("total_price") @db.Decimal(10, 2)
  deliveryDate   DateTime?   @map("delivery_date")
  createdAt      DateTime    @default(now()) @map("created_at")

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  delivery     Delivery?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

// ---------------------------------------------------------------------------
// 5. Payment System
// ---------------------------------------------------------------------------

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @map("order_id")
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  String        @map("payment_method")
  paymentStatus  PaymentStatus @map("payment_status")
  transactionId String?       @map("transaction_id")
  paidAt         DateTime?     @map("paid_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ---------------------------------------------------------------------------
// 6. Delivery System
// ---------------------------------------------------------------------------

model Delivery {
  id             String         @id @default(cuid())
  orderId        String         @unique @map("order_id")
  driverName     String         @map("driver_name")
  deliveryStatus DeliveryStatus @map("delivery_status")
  deliveredAt    DateTime?     @map("delivered_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

// ---------------------------------------------------------------------------
// 7. Referral System (Optional)
// ---------------------------------------------------------------------------

model Referral {
  id             String  @id @default(cuid())
  referrerId     String  @map("referrer_id")
  referredUserId String  @map("referred_user_id")
  rewardGiven    Boolean @default(false) @map("reward_given")

  referrer   User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@map("referrals")
}
